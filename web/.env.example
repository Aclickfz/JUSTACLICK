# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=justaclick

AUTH_SECRET=generate-a-long-random-string
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# SMTP (Hostinger / similar) — sends admin + user contact emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-smtp-password
AUTH_EMAIL_FROM=Just A Click <you@yourdomain.com>
# Where admin enquiry alerts go (required for admin copy). Comma-separated OK.
CONTACT_ADMIN_EMAIL=admin@yourdomain.com
